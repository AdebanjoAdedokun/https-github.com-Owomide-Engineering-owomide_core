load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_test")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")

npm_link_all_packages(name = "node_modules")

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    deps = ["//:tsconfig_base_json"],
)

ts_project(
    name = "migrate_ts",
    srcs = glob(
        ["src/**/*.ts"],
        exclude = ["src/tests/**"],
    ),
    declaration = True,
    declaration_map = True,
    out_dir = "dist",
    resolve_json_module = True,
    root_dir = "src",
    source_map = True,
    tsconfig = ":tsconfig",
    visibility = ["//visibility:public"],
    deps = [
        ":node_modules/@types/js-yaml",
        ":node_modules/@types/node",
        ":node_modules/@types/pg",
        ":node_modules/@types/yargs",
        ":node_modules/dotenv",
        ":node_modules/js-yaml",
        ":node_modules/pg",
        ":node_modules/yargs",
    ],
)

js_binary(
    name = "migrate",
    data = [":migrate_ts"],
    entry_point = "dist/index.js",
    visibility = ["//visibility:public"],
)

ts_project(
    name = "unit_tests_ts",
    srcs = glob(
        ["src/**/*.ts"],
        exclude = ["src/tests/integration/**"],
    ),
    declaration = True,
    declaration_map = True,
    out_dir = "dist_unit",
    resolve_json_module = True,
    root_dir = "src",
    source_map = True,
    tsconfig = ":tsconfig",
    deps = [
        ":migrate_ts",
        ":node_modules/@types/node",
        ":node_modules/vitest",
    ],
)

js_test(
    name = "unit_tests",
    data = [
        ":dist_unit/env.js",
        ":dist_unit/manifest.js",
        ":dist_unit/runner.js",
        ":dist_unit/sql-files.js",
        ":dist_unit/tests/unit/manifest.test.js",
        ":dist_unit/tests/unit/sql-files.test.js",
        ":dist_unit/tracker.js",
        ":node_modules/js-yaml",
        ":node_modules/vitest",
    ],
    entry_point = "src/tests/unit/run.js",
    visibility = ["//visibility:public"],
)

ts_project(
    name = "integration_tests_ts",
    srcs = glob(
        ["src/**/*.ts"],
        exclude = ["src/tests/unit/**"],
    ),
    declaration = True,
    declaration_map = True,
    out_dir = "dist_integration",
    resolve_json_module = True,
    root_dir = "src",
    source_map = True,
    tsconfig = ":tsconfig",
    deps = [
        ":migrate_ts",
        ":node_modules/@testcontainers/postgresql",
        ":node_modules/@types/node",
        ":node_modules/testcontainers",
        ":node_modules/vitest",
    ],
)

js_test(
    name = "integration_tests",
    data = [
        ":dist_integration/env.js",
        ":dist_integration/manifest.js",
        ":dist_integration/runner.js",
        ":dist_integration/sql-files.js",
        ":dist_integration/tests/integration/migrate.integration.test.js",
        ":dist_integration/tracker.js",
        ":node_modules/@testcontainers/postgresql",
        ":node_modules/dotenv",
        ":node_modules/js-yaml",
        ":node_modules/pg",
        ":node_modules/testcontainers",
        ":node_modules/vitest",
    ],
    entry_point = "src/tests/integration/run.js",
    tags = [
        "integration",
        "manual",
        "requires-docker",
    ],
    visibility = ["//visibility:public"],
)
