# Safe local default. Live mode remains fail-closed until the generated adapter is released.
VITE_WORKSPACE_MODE=fixture

# Browser requests use the same-origin Gateway route. Vite proxies this path locally.
VITE_API_BASE_URL=/api
WORKSPACE_DEV_GATEWAY_URL=http://127.0.0.1:5000

# Optional overrides for non-standard preview domains. Local, staging and
# production hosts derive the correct marketing/logout destination automatically.
# VITE_MARKETING_URL=https://preview.owomide.example/#top
# VITE_LOGOUT_URL=https://preview.owomide.example/#top

# Optional fixture-only latency used to make loading boundaries observable locally.
VITE_FIXTURE_LATENCY_MS=120
