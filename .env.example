DATABASE_URL=postgresql://postgres:postgres@localhost:5432/owomide

# Gateway auth
JWT_SECRET=dev-secret-for-local-testing-only
JWT_EXPIRES_IN=3600
DEV_USER_EMAIL=dev@owomide.local
DEV_USER_PASSWORD=dev
DEV_USER_ORG_ID=org-dev
DEV_USER_ID=user-dev
DEV_USER_ROLES=admin

CATALOG_SVC_PASSWORD=dev_catalog
PROPOSAL_SVC_PASSWORD=dev_proposal
MARGIN_SVC_PASSWORD=dev_margin
GOVERNANCE_SVC_PASSWORD=dev_governance
NOTIFY_SVC_PASSWORD=dev_notify
DATA_PIPELINE_SVC_PASSWORD=dev_data_pipeline

# Catalog runtime and internal caller credentials (development only)
CATALOG_DATABASE_URL=postgresql://catalog_svc:dev_catalog@localhost:5432/owomide
SERVICE_JWT_ISSUER=owomide-internal
CATALOG_SERVICE_JWT_ISSUER=owomide-internal
CATALOG_GATEWAY_SERVICE_SECRET=dev-only-catalog-gateway-secret-change-me
CATALOG_DATA_PIPELINE_SERVICE_SECRET=dev-only-catalog-pipeline-secret-change-me
CATALOG_PROPOSAL_SERVICE_SECRET=dev-only-catalog-proposal-secret-change-me
CATALOG_SERVICE_SECRETS_JSON={"gateway_svc":"dev-only-catalog-gateway-secret-change-me","data_pipeline_svc":"dev-only-catalog-pipeline-secret-change-me","proposal_svc":"dev-only-catalog-proposal-secret-change-me"}

# Data Pipeline runtime and inbound Gateway credential (development only)
DATA_PIPELINE_DATABASE_URL=postgresql://data_pipeline_svc:dev_data_pipeline@localhost:5432/owomide
DATA_PIPELINE_SERVICE_JWT_ISSUER=owomide-internal
DATA_PIPELINE_SERVICE_JWT_AUDIENCE=data-pipeline
DATA_PIPELINE_SERVICE_SECRETS_JSON={"gateway_svc":"dev-only-data-pipeline-gateway-secret-change-me"}
