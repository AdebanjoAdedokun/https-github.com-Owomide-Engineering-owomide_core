# gazelle:proto disable_global
load("@aspect_rules_js//js:defs.bzl", "js_library")

package(default_visibility = ["//visibility:public"])

js_library(
    name = "pkg",
    srcs = [
        "package.json",
    ] + glob(["gen/ts/**/*.js"]),
    types = glob(["gen/ts/**/*.d.ts"]),
)

genrule(
    name = "generate",
    srcs = glob(["**/*.proto"]),
    outs = ["gen_marker"],
    cmd = """
        cd $$(dirname $(location buf.yaml)) && \
        buf generate && \
        touch $(OUTS)
    """,
    tags = ["manual"],
    tools = [
        "buf.gen.yaml",
        "buf.yaml",
    ],
)

# Generated TypeScript types — populated after `make proto` / `buf generate`
filegroup(
    name = "gen_ts",
    srcs = glob(
        ["gen/ts/**/*.ts"],
        allow_empty = True,
    ),
)

# Generated Python types — populated after `make proto` / `buf generate`
filegroup(
    name = "gen_py",
    srcs = glob(
        ["gen/py/**/*.py"],
        allow_empty = True,
    ),
)
