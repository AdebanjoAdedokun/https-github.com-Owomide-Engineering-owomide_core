load("@aspect_rules_js//js:defs.bzl", "js_binary")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")

npm_link_all_packages()

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    deps = ["//:tsconfig_base_json"],
)

ts_project(
    name = "bus_smoke_ts",
    srcs = glob(["src/**/*.ts"]),
    declaration = True,
    declaration_map = True,
    out_dir = "dist",
    resolve_json_module = True,
    root_dir = "src",
    source_map = True,
    tsconfig = ":tsconfig",
    visibility = ["//visibility:public"],
    deps = [
        ":node_modules/@bufbuild/protobuf",
        ":node_modules/@owomide/bus",
        ":node_modules/@owomide/proto",
        ":node_modules/@types/node",
        ":node_modules/fastify",
    ],
)

js_binary(
    name = "publisher",
    data = [":bus_smoke_ts"],
    entry_point = "dist/publisher.js",
    visibility = ["//visibility:public"],
)

js_binary(
    name = "subscriber",
    data = [":bus_smoke_ts"],
    entry_point = "dist/subscriber.js",
    visibility = ["//visibility:public"],
)
