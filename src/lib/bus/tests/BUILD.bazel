py_binary(
    name = "interop_py",
    srcs = ["interop_py.py"],
    visibility = ["//:__subpackages__"],
    deps = ["//src/lib/bus/py/owomide_bus"],
)

py_library(
    name = "tests_py",
    srcs = ["interop_py.py"],
    visibility = ["//:__subpackages__"],
    deps = ["//src/lib/bus/py/owomide_bus"],
