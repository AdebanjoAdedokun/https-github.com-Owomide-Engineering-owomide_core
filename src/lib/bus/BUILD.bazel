load("@rules_python//python:defs.bzl", "py_library")

# JS target lives in //src/lib/bus/js:bus_js (its own npm workspace package)
# Go targets are Gazelle-managed: //src/lib/bus/go/pkg/bus

# --- Python ---

py_library(
    name = "bus_py",
    srcs = glob(
        ["py/owomide_bus/**/*.py"],
        exclude = ["py/owomide_bus/tests/**"],
    ),
    imports = ["py"],
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = [
        "//src/lib/proto:gen_py",
    ],
)
