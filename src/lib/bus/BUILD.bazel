load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@rules_python//python:defs.bzl", "py_library")

# --- Node.js / TypeScript ---
# Go targets are Gazelle-managed: //src/lib/bus/go/pkg/bus

ts_project(
    name = "bus_js",
    srcs = glob(
        ["js/src/**/*.ts"],
        exclude = ["js/src/tests/**"],
    ),
    declaration = True,
    tsconfig = "js/tsconfig.json",
    visibility = ["//visibility:public"],
    deps = [
        "//:node_modules/@bufbuild/protobuf",
        "//:node_modules/kafkajs",
        "//src/lib/proto:gen_ts",
    ],
)

# --- Python ---

py_library(
    name = "bus_py",
    srcs = glob(
        ["py/owomide_bus/**/*.py"],
        exclude = ["py/owomide_bus/tests/**"],
    ),
    imports = ["py"],
    visibility = ["//visibility:public"],
    deps = [
        "//src/lib/proto:gen_py",
    ],
)
